# Banco Turso (libSQL). O token e criado no painel da Turso, em apostacerta > Create token.
TURSO_DATABASE_URL=libsql://apostacerta-edvaldomil.aws-us-east-1.turso.io
TURSO_AUTH_TOKEN=

# Segredo longo e aleatorio para o cookie de sessao. Nunca commitar o valor real.
JWT_SECRET=

APP_URL=http://localhost:3000

# E-mails que ignoram a trava de pagamento, separados por virgula.
ADMIN_EMAILS=

# Mercado Pago Checkout Pro. Ficam so no servidor.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
